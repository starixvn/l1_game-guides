{
    "name": "my-app",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "next dev -p 3001",
        "dev-node18": "set NODE_OPTIONS=--openssl-legacy-provider && next dev -p 3001",
        "build": "next build",
        "build-node18": "set NODE_OPTIONS=--openssl-legacy-provider && next build",
        "start": "PORT=5000 next start",
        "start:window": "next start -p 5000",
        "lint": "next lint",
        "test": "jest",
        "test:watch": "jest --watch",
        "test-coverage": "jest --coverage",
        "reg": "npm set registry http://npm.lumigame.com"
    },
    "dependencies": {
        "@sentry/node": "^8.50.0",
        "@tolgee/format-icu": "^6.0.0",
        "@tolgee/react": "^6.0.0",
        "bootstrap": "^5.3.3",
        "i18next": "^24.2.1",
        "interweave": "^13.1.0",
        "next": "^15.1.4",
        "next-i18next": "^15.4.1",
        "next-themes": "^0.4.4",
        "react": "^19.0.0",
        "react-device-detect": "^2.2.3",
        "react-dom": "^19.0.0",
        "react-i18next": "^15.4.0",
        "sass": "1.43.4",
        "uuid": "^11.0.5"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.26.0",
        "@babel/preset-react": "^7.26.3",
        "@commitlint/cli": "^19.6.1",
        "@commitlint/config-conventional": "^19.6.0",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/jest": "^29.5.14",
        "@types/react": "^19.0.7",
        "@types/react-dom": "^19.0.3",
        "@types/uuid": "^10.0.0",
        "babel-jest": "^29.7.0",
        "critters": "^0.0.25",
        "eslint": "^9.18.0",
        "eslint-config-next": "^15.1.4",
        "husky": "^9.1.7",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jest-extended": "^4.0.2",
        "jest-sonar-reporter": "^2.0.0",
        "react-test-renderer": "^19.0.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.3"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
