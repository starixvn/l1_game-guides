{
    "name": "my-app",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "generate-tolgee-data": "ts-node ./src/helpers/tolgee-generator.ts",
        "analyze": "cross-env ANALYZE=true next build",
        "dev": "npm run generate-tolgee-data &&  next dev -p 3001",
        "dev-node18": "npm run generate-tolgee-data &&  set NODE_OPTIONS=--openssl-legacy-provider && next dev -p 3001",
        "build": "next build",
        "build-node18": "set NODE_OPTIONS=--openssl-legacy-provider && next build",
        "start": "PORT=5000 next start",
        "start:window": "next start -p 5000",
        "lint": "next lint",
        "test": "jest",
        "test:watch": "jest --watch",
        "test-coverage": "jest --coverage",
        "reg": "npm set registry http://npm.lumigame.com"
    },
    "dependencies": {
        "@tolgee/format-icu": "^5.7.0",
        "@tolgee/react": "^5.28.6",
        "bootstrap": "^5.0.1",
        "i18next": "^23.4.4",
        "interweave": "^13.0.0",
        "next": "^13.4.19",
        "next-i18next": "^14.0.0",
        "next-themes": "^0.2.1",
        "react": "^18.2.0",
        "react-device-detect": "^2.2.3",
        "react-dom": "^18.2.0",
        "react-i18next": "^13.1.2",
        "sass": "^1.43.4",
        "uuid": "^8.3.2"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.14.5",
        "@babel/preset-react": "^7.14.5",
        "@commitlint/cli": "^13.1.0",
        "@commitlint/config-conventional": "^13.1.0",
        "@types/enzyme": "^3.10.8",
        "@types/enzyme-adapter-react-16": "^1.0.6",
        "@types/jest": "^26.0.23",
        "@types/node": "^22.3.0",
        "@types/react": "17.0.9",
        "@types/react-dom": "^18.0.10",
        "@types/uuid": "^8.3.0",
        "babel-core": "^6.26.3",
        "babel-jest": "^27.0.2",
        "critters": "^0.0.16",
        "cross-env": "^7.0.3",
        "enzyme": "^3.11.0",
        "enzyme-adapter-react-16": "^1.15.6",
        "enzyme-to-json": "^3.6.2",
        "eslint": "^7.31.0",
        "eslint-config-next": "^11.0.1",
        "husky": "^7.0.1",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^27.0.4",
        "jest-extended": "^0.11.5",
        "jest-sonar-reporter": "^2.0.0",
        "react-test-renderer": "^17.0.2",
        "ts-jest": "^27.0.3",
        "ts-node": "^10.4.0",
        "typescript": "^5.5.4"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}